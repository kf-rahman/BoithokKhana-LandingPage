# Root .env for docker-compose (${VAR} substitution). Copy to `.env` and fill
# in — `.env` is gitignored; never commit real secrets.
#
# Backend-only local dev (no Docker) reads backend/.env instead — see
# backend/.env.example.

# --- Postgres (the compose `db` service) ---
POSTGRES_PASSWORD=boithok

# --- Admin sign-in (v1 shared PIN) — CHANGE before any real deployment ---
ADMIN_PIN=change-me

# --- Order parsing (Claude). Leave blank to disable parsing (orders still
#     save; they stay pending_parse until a key is set). ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- CORS: browser origins allowed to call the API (JSON array). In
#     production set this to your deployed frontend URL. ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Email (order confirmations) — leave SMTP_HOST blank to disable ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@boithokkhana.ca

# --- Error reporting (Sentry). Leave blank to disable — nothing is sent
#     anywhere until a DSN is set. Get the DSN from the Sentry project's
#     Settings -> Client Keys (DSN). ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# The browser-side DSN. NEXT_PUBLIC_* is inlined at build time, so changing
# this requires a rebuild/redeploy, not just a restart.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
