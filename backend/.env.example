# Local dev defaults to SQLite — no Docker needed.
# For Postgres: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/catering
DATABASE_URL=sqlite+aiosqlite:///./catering.db

# Order parsing (Claude). Leave key blank to disable parsing locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Admin dashboard shared PIN — change this before any real use.
ADMIN_PIN=1234

# Frontend origin(s) allowed by CORS (JSON list).
CORS_ORIGINS=["http://localhost:3000"]
