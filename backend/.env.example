# Copy to `.env` and fill in. `.env` is gitignored AND blocked by the pre-commit
# hook — never commit real secrets.

# --- Admin sign-in (v1 shared PIN) ---
# This is the password for the /admin area. CHANGE IT — pick something strong.
ADMIN_PIN=change-me

# --- Database ---
# Local dev defaults to SQLite if unset. For production, use Postgres:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./boithok.db

# --- Order parsing (Claude) ---
# Without a key, parsing is disabled and the parse endpoints return 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- CORS: browser origins allowed to call the API (JSON array) ---
# In production set this to your frontend URL, e.g.:
#   CORS_ORIGINS=["https://order.boithokkhana.ca"]
CORS_ORIGINS=["http://localhost:3000"]

# --- Email (order confirmations) — leave SMTP_HOST blank to disable ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@boithokkhana.ca
SMTP_USE_TLS=true
