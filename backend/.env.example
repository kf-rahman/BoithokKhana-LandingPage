# Local dev defaults to SQLite — no Docker needed.
# Postgres: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/catering
DATABASE_URL=sqlite:///./app.db

# Order parsing (Claude). Leave blank to disable parsing locally
# (orders still save; they just stay pending_parse).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

CORS_ORIGINS=["http://localhost:3000"]
